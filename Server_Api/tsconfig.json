{
  "compilerOptions": {
    /* Destino y Sistema de Módulos */
    "target": "ES2022" /* Genera código JS moderno soportado por Node actual */,
    "module": "NodeNext" /* Vital para que soporte ES Modules nativos y reconozca los .js en los imports */,
    "moduleResolution": "NodeNext" /* Estrategia de resolución de módulos emparejada con NodeNext */,

    /* Directorios */
    "outDir": "./dist" /* Dónde se guardará el código JS compilado */,
    "rootDir": "./src" /* Dónde está tu código fuente de TypeScript */,

    /* Comprobaciones Estrictas de Calidad */
    "strict": true /* Activa todas las comprobaciones estrictas de tipos */,
    "noImplicitAny": true /* Error cuando una variable tiene un tipo 'any' implícito */,
    "strictNullChecks": true /* Te obliga a manejar 'null' y 'undefined' de forma segura */,
    "strictFunctionTypes": true,
    /* Otras Configuraciones de Compilación */
    "esModuleInterop": true /* Permite importar módulos CommonJS como si fueran ES Modules */,
    "skipLibCheck": true /* Como vimos con Karma, acelera la compilación ignorando errores en node_modules */,
    "forceConsistentCasingInFileNames": true /* Evita problemas si desarrollas en Windows y luego subes a un server Linux */,
    "resolveJsonModule": true /* Te permite hacer 'import data from "./archivo.json"' directamente */,
    "sourceMap": true /* Útil para debuggear el código TS original si algo rompe en producción */
  },
  "include": ["src/**/*"] /* Qué archivos debe compilar */,
  "exclude": ["node_modules", "dist"] /* Qué archivos debe ignorar */,
  "ts-node": {
    "esm": true
  }
}
