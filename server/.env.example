# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/world_of_stories

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN_DAYS=7

# Orígenes del front separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# Código que un lector debe ingresar para volverse escritor (POST /me/become-writer)
WRITER_INVITE_CODE=am I a Writer?

LOG_LEVEL=info
